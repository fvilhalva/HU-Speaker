# ============================================================================
# HU-Speaker Configuration - Exemplo Padrão
# ============================================================================
# Copie este arquivo para .env e preencha com suas configurações reais
# IMPORTANTE: Nunca commit o arquivo .env no repositório
# ============================================================================


# Aplicação
APP_NAME=HU-Speaker API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Servidor
HOST=0.0.0.0
PORT=8082

# ============================================================================
# Banco de Dados (se necessário para persistência futura)
# ============================================================================
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/hu_speaker_db

# ============================================================================
# Autenticação JWT

# Token JWT de teste para chamadas manuais/Postman. Gere um novo em produção.
# Exemplo de claims: sub, source_system, actor_id, actor_name, actor_role, request_id, exp
JWT_TEST_TOKEN=cole-aqui-um-jwt-gerado
# ============================================================================
# Gere uma chave forte em produção: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# Integração com Sistema de Informação Hospitalar (HIS)
# ============================================================================
# Exemplo: MV2k, Tasy, Centaur, etc
HIS_API_URL=http://his-system.hospital.local:8080/api
HIS_API_KEY=seu-api-key-do-his
HIS_API_TIMEOUT=30

# ============================================================================
# Configurações Piper TTS (Síntese de Voz)
# ============================================================================
# Nome do arquivo ONNX dentro de src/hu_speaker/models
PIPER_MODEL=pt_BR-faber-medium.onnx
PIPER_SPEAKERS=0
AUDIO_OUTPUT_DIR=/tmp/hu-speaker-audio
MAX_TEXT_LENGTH=1000

# ============================================================================
# Email para Notificações (se necessário)
# ============================================================================
SMTP_HOST=smtp.hospital.local
SMTP_PORT=587
SMTP_USER=hu-speaker@hospital.local
SMTP_PASSWORD=sua-senha-smtp
SMTP_FROM=hu-speaker@hospital.local
SMTP_TLS=true

# ============================================================================
# CORS - Origens permitidas (HIS, Web, Apps)
# ============================================================================
# Separe múltiplas origens por vírgula
CORS_ORIGINS=http://localhost:3000,http://his-system.hospital.local:8080,http://app.hospital.local

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/hu-speaker/app.log
